# Copy to .env and fill in values from the Neon console (Connect > Prisma).
# Never commit .env.

# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection (no "-pooler"). Used only by the Prisma CLI (migrate, studio).
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
