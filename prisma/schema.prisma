// Prisma ORM 7 schema. Datasource URL lives in prisma.config.ts (CLI) and
// lib/db.ts (runtime, via the Neon driver adapter).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum IdentityType {
  ACCOUNT
  PARTICIPANT
}

enum AttemptStatus {
  ACTIVE
  SUBMITTED
  CANCELLED
}

model Branch {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model User {
  id                  String @id @default(cuid())
  employeeCode        String @unique
  name                String
  email               String?
  branchId            String
  branch              Branch @relation(fields: [branchId], references: [id])
  role                Role @default(EMPLOYEE)
  identityType        IdentityType @default(ACCOUNT)
  birthDate           DateTime? @db.Date
  department          String?
  passwordHash        String?
  mustChangePassword  Boolean @default(true)
  isActive            Boolean @default(true)
  failedLoginAttempts Int @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  quizRevision        Int @default(0)
  createdAt           DateTime @default(now())
  sessions            Session[]
  attempts            Attempt[]
  auditLogs           AuditLog[]
  @@index([branchId, role, isActive])
}

model Session {
  id           String @id @default(cuid())
  tokenHash    String @unique
  userId       String
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Topic {
  id           String @id
  code         String @unique
  part         String
  title        String
  sort         Int
  isActive     Boolean @default(true)
  timeLimitMin Int?
  questions    Question[]
  attempts     Attempt[]
}

model Question {
  id           String @id
  topicId      String
  topic        Topic @relation(fields: [topicId], references: [id])
  text         String
  options      String[]
  correctIndex Int
  explanation  String
  isActive     Boolean @default(true)
  updatedAt    DateTime @updatedAt
  snapshots    AttemptQuestion[]
  @@index([topicId, isActive])
}

model Attempt {
  id              String @id @default(cuid())
  userId          String
  user            User @relation(fields: [userId], references: [id])
  topicId         String?
  topic           Topic? @relation(fields: [topicId], references: [id])
  title           String
  status          AttemptStatus @default(ACTIVE)
  activeKey       String? @unique
  startedAt       DateTime @default(now())
  deadlineAt      DateTime?
  expiresAt       DateTime
  submittedAt     DateTime?
  durationSeconds Int @default(0)
  score           Int @default(0)
  total           Int
  percentage      Float @default(0)
  passThreshold   Int @default(80)
  passed          Boolean @default(false)
  questions       AttemptQuestion[]
  @@index([userId, status, submittedAt])
  @@index([topicId, status, submittedAt])
}

model AttemptQuestion {
  id            String @id @default(cuid())
  attemptId     String
  attempt       Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id])
  topicId       String
  position      Int
  text          String
  options       String[]
  correctIndex  Int
  explanation   String
  selectedIndex Int?
  answeredAt    DateTime?
  @@unique([attemptId, position])
  @@index([questionId])
}

model Settings {
  id               String @id @default("main")
  passThreshold    Int @default(80)
  mixedCount       Int @default(40)
  showAnswers      Boolean @default(true)
  allowLeaderboard Boolean @default(true)
  maxAttempts      Int @default(0)
}

model AuditLog {
  id        String @id @default(cuid())
  actorId   String?
  actor     User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  details   String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
